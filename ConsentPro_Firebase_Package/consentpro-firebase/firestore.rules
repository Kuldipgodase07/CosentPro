rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ConsentPro Production & Demo Firestore Security Rules
    // Allows full real-time synchronization between the ConsentPro client and Firestore
    match /users/{uid} {
      allow read, write: if true;
    }

    match /principals/{pid}/{document=**} {
      allow read, write: if true;
    }

    match /tenants/{tid} {
      allow read, write: if true;
      
      match /{document=**} {
        allow read, write: if true;
      }
    }

    match /{document=**} {
      allow read, write: if true;
    }
  }
}
